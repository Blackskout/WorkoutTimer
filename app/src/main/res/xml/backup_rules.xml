<?xml version="1.0" encoding="utf-8"?>
<!--
    Правила бэкапа для Android 11 и ниже. Для Android 12+ — data_extraction_rules.xml,
    там же объяснение, почему в бэкапе только база. Держать оба файла одинаковыми.
-->
<full-backup-content>
    <include domain="database" path="workout_db" />
    <include domain="database" path="workout_db-wal" />
    <include domain="database" path="workout_db-shm" />
</full-backup-content>
